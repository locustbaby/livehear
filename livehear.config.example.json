{
  "soniox": {
    "api_key": "YOUR_SONIOX_API_KEY",
    "ws_url": "wss://stt-rt.soniox.com/transcribe-websocket",
    "model": "stt-rt-v6",
    "sample_rate": 16000,
    "enable_speaker_diarization": true,
    "enable_endpoint_detection": true,
    "language_hints": ["en", "zh"],
    "language_hints_strict": true,
    "enable_translation": true,
    "translation_type": "two_way",
    "target_language": "zh",
    "speak_target_language": "en",
    "language_a": "en",
    "language_b": "zh",
    "max_endpoint_delay_ms": 2000,
    "endpoint_sensitivity": -0.2,
    "custom_terms": ["Kubernetes", "Soniox", "OpenRouter", "SLA"],
    "enable_vad": true,
    "vad_threshold": 1.8,
    "input_device": null
  },
  "openrouter": {
    "api_key": "YOUR_OPENROUTER_OR_OPENAI_COMPATIBLE_API_KEY",
    "base_url": "https://openrouter.ai/api/v1",
    "translate_model": "deepseek/deepseek-chat",
    "predict_model": "deepseek/deepseek-chat",
    "enable_polish": true
  },
  "jev": {
    "enabled": true,
    "api_key": "YOUR_OPENROUTER_OR_OPENAI_COMPATIBLE_API_KEY",
    "base_url": "https://openrouter.ai/api/v1",
    "model": "deepseek/deepseek-chat",
    "confidence_threshold": 0.8
  },
  "meeting": {
    "auto_predict": true,
    "context": "跨国远程团队日常同步与架构评审周会"
  },
  "storage": {
    "auto_save": true,
    "save_dir": "~/Documents/livehear",
    "file_format": "txt"
  }
}
